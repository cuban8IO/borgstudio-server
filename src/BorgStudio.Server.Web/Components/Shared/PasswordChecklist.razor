@* Shows which password rules a password meets. On pages without an interactive connection,
   wwwroot/js/app.js updates the list while the user types (data-password-for / data-confirm-for);
   interactive pages pass Password and Confirmation instead. *@
<ul class="password-rules"
    data-password-for="@For"
    data-confirm-for="@ConfirmFor"
    data-min-length="@PasswordPolicy.MinimumLength"
    aria-live="polite">
    @foreach (var (rule, text) in Rules)
    {
        <li data-rule="@rule" class="@(IsMet(rule) ? "met" : null)">@text</li>
    }
</ul>

@code {
    /// <summary>Id of the password input (static pages).</summary>
    [Parameter]
    public string? For { get; set; }

    /// <summary>Id of the "repeat password" input (static pages); adds the rule that both match.</summary>
    [Parameter]
    public string? ConfirmFor { get; set; }

    /// <summary>The password typed so far (interactive pages).</summary>
    [Parameter]
    public string? Password { get; set; }

    /// <summary>The repeated password (interactive pages); adds the rule that both match.</summary>
    [Parameter]
    public string? Confirmation { get; set; }

    [Parameter]
    public bool ShowMatch { get; set; }

    private IEnumerable<(string Rule, string Text)> Rules
    {
        get
        {
            yield return ("length", string.Format(Strings.PasswordRuleLength, PasswordPolicy.MinimumLength));
            yield return ("upper", Strings.PasswordRuleUpper);
            yield return ("lower", Strings.PasswordRuleLower);
            yield return ("digit", Strings.PasswordRuleDigit);
            yield return ("symbol", Strings.PasswordRuleSymbol);
            if (ShowMatch || ConfirmFor is not null)
            {
                yield return ("match", Strings.PasswordRuleMatch);
            }
        }
    }

    private bool IsMet(string rule) => rule switch
    {
        "length" => PasswordPolicy.HasMinimumLength(Password),
        "upper" => PasswordPolicy.HasUpper(Password),
        "lower" => PasswordPolicy.HasLower(Password),
        "digit" => PasswordPolicy.HasDigit(Password),
        "symbol" => PasswordPolicy.HasSymbol(Password),
        "match" => !string.IsNullOrEmpty(Password) && Password == Confirmation,
        _ => false,
    };
}
