@using System.Globalization
@using BorgStudio.Server.Application.Statistics

@* Twelve weeks, one square per day (weeks as columns, Monday on top), colored by the worst outcome of the day. *@
<figure class="chart" role="img" aria-label="@Label">
    <svg viewBox="0 0 @Fmt(Weeks * Cell + 30) @Fmt(7 * Cell + 4)" class="chart-svg calendar-svg">
        @foreach (var (label, row) in new[] { (Weekday(DayOfWeek.Monday), 0), (Weekday(DayOfWeek.Wednesday), 2), (Weekday(DayOfWeek.Friday), 4) })
        {
            @SvgText.Of("0", Fmt(row * Cell + Cell * 0.75), "start", "chart-label", label)
        }

        @foreach (var day in Days)
        {
            var (column, row) = Position(day.Day);
            <rect x="@Fmt(30 + column * Cell)" y="@Fmt(row * Cell)" width="@Fmt(Cell - 3)" height="@Fmt(Cell - 3)" rx="2"
                  fill="@(day.Count == 0 ? ChartColors.Muted : ChartColors.Of(day.Health))"
                  opacity="@(day.Count == 0 ? "0.25" : "1")" class="calendar-day">
                <title>@Tooltip(day)</title>
            </rect>
        }
    </svg>
</figure>

@code {
    private const double Cell = 14;

    [Parameter, EditorRequired]
    public IReadOnlyList<DayActivity> Days { get; set; } = [];

    [Parameter]
    public Func<DayActivity, string> Tooltip { get; set; } = d => d.Day.ToString("d", CultureInfo.CurrentCulture);

    [Parameter]
    public string Label { get; set; } = string.Empty;

    private int Weeks => Days.Count == 0 ? 12 : Position(Days[^1].Day).Column + 1;

    private (int Column, int Row) Position(DateOnly day)
    {
        var first = Days.Count == 0 ? day : Days[0].Day;
        var firstMonday = first.AddDays(-(((int)first.DayOfWeek + 6) % 7));
        var offset = day.DayNumber - firstMonday.DayNumber;
        return (offset / 7, offset % 7);
    }

    private static string Weekday(DayOfWeek day) => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day);

    private static string Fmt(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
