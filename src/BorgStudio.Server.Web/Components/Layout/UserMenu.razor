@inject NavigationManager Navigation

<MudMenu Icon="@Icons.Material.Filled.AccountCircle"
         Color="Color.Inherit"
         AriaLabel="@Strings.UserMenuLabel"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Dense="true">
    <MudText Typo="Typo.body2" Class="px-4 py-2 mud-text-secondary">@UserName</MudText>
    <MudDivider />
    <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts" Href="account">@Strings.NavAccount</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.NewReleases" Href="changelog">@Strings.NavChangelog</MudMenuItem>
    <form action="account/logout" method="post" class="user-menu-form">
        <AntiforgeryToken />
        <button type="submit" class="mud-menu-item mud-menu-item-dense user-menu-button">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-3" />
            <span>@Strings.SignOut</span>
        </button>
    </form>
</MudMenu>

@code {
    [Parameter]
    public string? UserName { get; set; }
}
