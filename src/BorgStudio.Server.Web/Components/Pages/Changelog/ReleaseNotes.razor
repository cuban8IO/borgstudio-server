@using System.Globalization
@using BorgStudio.Server.Domain.Changelogs

@* One release: version, date and its changes; pull request numbers link to GitHub. *@
<section class="release-notes">
    <div class="d-flex align-center gap-2 mb-1">
        <MudText Typo="Typo.h6" HtmlTag="h3">@Release.Version</MudText>
        @if (Release.Date is { } date)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@date.ToString("d", CultureInfo.CurrentCulture)</MudText>
        }
        @if (Installed)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@Strings.ChangelogInstalled</MudChip>
        }
    </div>
    @foreach (var section in Release.Sections)
    {
        <MudText Typo="Typo.subtitle2" HtmlTag="h4" Class="mt-2">@SectionTitle(section.Title)</MudText>
        <ul class="release-items">
            @foreach (var item in section.Items)
            {
                <li>
                    @item.Text
                    @if (item.PullRequest is { } number)
                    {
                        <text> </text><MudLink Href="@($"https://github.com/cuban8IO/borgstudio-server/pull/{number}")" Target="_blank">#@number</MudLink>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public ChangelogRelease Release { get; set; } = default!;

    [Parameter]
    public bool Installed { get; set; }

    private static string SectionTitle(string title) => title switch
    {
        "New features" => Strings.ChangelogSectionFeatures,
        "Fixes" => Strings.ChangelogSectionFixes,
        _ => title,
    };
}
